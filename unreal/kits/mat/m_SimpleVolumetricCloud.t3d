      MaterialExpressionGuid=20D18CF3482705A86431F08716E74311
      Material="/Script/Engine.Material'm_SimpleVolumetricCloud'"
      Desc="This parameter controls the multiplicative contribution to the overall cloud noise of each of the channels, as well as the total magnitude of the multiplicative effect (via the alpha channel).   In other words the cloud noise is multiplied by a factor determined by this formula:  MultChannel.a * (Noise.r * MultChannel.r + Noise.g * MultChannel.g + Noise.b * MultChannel.b)."
      bCommentBubbleVisible=True
      Outputs(0)=(OutputName="")
      Outputs(1)=(OutputName="")
      Outputs(2)=(OutputName="")
      Outputs(3)=(OutputName="")
      Outputs(4)=(OutputName="MultStrength")
      Outputs.RemoveIndex(5)
   End Object
