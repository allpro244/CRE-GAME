      DefaultValue=(R=0.800000,G=0.166667,B=0.575000,A=1.000000)
      ChannelNames=(R=NSLOCTEXT("", "E4D95AFF47E4602934D10ABD311D2C14", "Phase A"),G=NSLOCTEXT("", "134F9C6F45C013CDA3D96FAB08F1F3D6", "Phase B"),B=NSLOCTEXT("", "271596044E268917EB9201BDFA1687AC", "Phase Blend"),A=NSLOCTEXT("", "1C4FB26845A08ED3F94E1CBA693B25A1", "N / A"))
      ParameterName="Phase_Controls"
