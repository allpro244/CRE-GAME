# Pipeline output. The app GENERATES its city now — see src/citygen — so this
# is only the pipeline's own audit material: coverage numbers, the plan SVGs
# and the tile archives. Nothing here ships.
pipeline/raw/
pipeline/out/
pipeline/plan/

*.tsbuildinfo
dist-zip/
# Generated engine bundles. The harness builds test/.engine.mjs; concurrent
# investigations build their own suffixed copies so they do not race each
# other over one shared file.
test/.entry*.ts
test/.engine*.mjs
*.png

# Throwaway diagnostic probes. These are scratch: written to answer one
# question, read once, deleted. Anything worth keeping graduates to test/ with
# a pnpm script behind it, the way test/banks.mjs did.
probe*.mjs
dbg*.mjs
check*.mjs
.audit/
.audit-rails/
dist-gallery/
