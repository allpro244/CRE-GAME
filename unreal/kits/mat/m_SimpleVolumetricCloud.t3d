      MaterialExpressionEditorX=1712
      MaterialExpressionEditorY=592
      MaterialExpressionGuid=F5567FA14A13752AED448B823E7A43DA
      Material="/Script/Engine.Material'm_SimpleVolumetricCloud'"
      Desc="The cloud scattering uses a combination of two phase functions to determine how light bounces in the material.  Phase A and B determine the directionality of the light scattering, where negative values scatter backward toward the source and positive values scatter forward, away from the source. These values are defined in the range [-1, 1].  The phase blend determines how strong the contribution of each phase is, where 0 is entirely Phase A, and 1 is entirely Phase B. "
      bCommentBubbleVisible=True
      Outputs(0)=(OutputName="")
      Outputs(1)=(OutputName="Phase A")
      Outputs(2)=(OutputName="Phase B")
      Outputs(3)=(OutputName="Phase Blend")
      Outputs(4)=(OutputName="N / A")
      Outputs.RemoveIndex(5)
   End Object
